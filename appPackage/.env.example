# Configuration inventory for a separately configured packaging lifecycle.
# This repository does not load this file or provide a toolkit lifecycle.
# Copy values into that lifecycle's approved local environment, never source JSON.
# Fill every blank with your actual authorized metadata before packaging.
TEAMS_APP_ID=
APP_NAME_SUFFIX=
MCP_URL=
PUBLISHER_NAME=
PUBLISHER_EMAIL=
PUBLISHER_WEBSITE_URL=
PUBLISHER_PRIVACY_URL=
PUBLISHER_TERMS_URL=
# MCP_URL must be the complete approved HTTPS fictional public mock endpoint.
# Anonymous auth is mock-only. Production requires platform vault-backed auth
# and server-side authorization; do not put credentials in this example.