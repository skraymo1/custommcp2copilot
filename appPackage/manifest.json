{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
    "manifestVersion": "1.30",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "${{PUBLISHER_NAME}}",
        "websiteUrl": "${{PUBLISHER_WEBSITE_URL}}",
        "privacyUrl": "${{PUBLISHER_PRIVACY_URL}}",
        "termsOfUseUrl": "${{PUBLISHER_TERMS_URL}}"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Custom chat app${{APP_NAME_SUFFIX}}",
        "full": "Custom chat app fictional knowledge demo"
    },
    "description": {
        "short": "Read-only fictional knowledge demo",
        "full": "Explore fictional project planning, onboarding, and service operations with cited mock evidence. Not real organizational guidance."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [],
    "validDomains": []
}